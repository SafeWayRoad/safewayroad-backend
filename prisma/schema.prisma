generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Roles, company accounts and users (cf. cahier des charges §3.2)
//
// Naming convention: all identifiers (models, fields, enums) are in English.
// User-submitted content (e.g. company names, incident photos) may of course
// remain in French — only the schema's own vocabulary is English.
// ---------------------------------------------------------------------------

enum RoleName {
  PLATFORM_ADMIN
  MINI_ADMIN
  TEAM_LEAD
  DRIVER
  USER
}

enum AccountStatus {
  FREE
  PREMIUM
  ENTERPRISE
}

model Role {
  id             String   @id @default(cuid())
  name           RoleName @unique
  hierarchyLevel Int

  users User[]
}

model Company {
  id             String    @id @default(cuid())
  name           String
  miniAdminId    String?   @unique
  pilotStartDate DateTime?
  pilotEndDate   DateTime?
  createdAt      DateTime  @default(now())

  teams Team[]
  users User[]
}

model Team {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  users User[]
}

model User {
  id            String        @id @default(cuid())
  phone         String?       @unique
  email         String?       @unique
  passwordHash  String
  accountStatus AccountStatus @default(FREE)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id])

  reportedIncidents Incident[]      @relation("IncidentReportedBy")
  confirmations     Confirmation[]
  itineraries       Itinerary[]
  trips             Trip[]

  @@index([companyId])
  @@index([teamId])
}

// ---------------------------------------------------------------------------
// Road network (Routes Nationales and segments — cf. architecture technique §3)
// ---------------------------------------------------------------------------

model RouteAxis {
  id         String  @id @default(cuid())
  code       String  @unique // e.g. "N1", "N3", "N4"
  commonName String?

  segments RoadSegment[]
}

model RoadSegment {
  id      String @id @default(cuid())
  pkStart Float?
  pkEnd   Float?

  // Identifiant du way OSM d'origine — permet de relancer le script
  // d'import sans dupliquer les tronçons (upsert). Null pour tout segment
  // créé manuellement (aucun cas actuellement, hors le segment de test
  // historique qui sera supprimé après vérification).
  osmWayId BigInt? @unique

  geom Unsupported("geometry(LineString, 4326)")

  routeAxisId String
  routeAxis   RouteAxis @relation(fields: [routeAxisId], references: [id], onDelete: Cascade)

  incidents         Incident[]
  itinerarySegments ItinerarySegment[]

  @@index([routeAxisId])
}

// ---------------------------------------------------------------------------
// Incidents and community confirmation (cf. cahier des charges §4.3-4.4)
// ---------------------------------------------------------------------------

enum IncidentTypeLabel {
  ACCIDENT
  BREAKDOWN
  OBSTACLE
  INSECURITY
  MEDICAL_EMERGENCY
}

enum Direction {
  OUTBOUND
  RETURN
  BOTH
}

enum RoadStatus {
  BLOCKED
  PARTIAL
  CLEAR
}

enum IncidentStatus {
  ACTIVE
  RESOLVED
}

model IncidentType {
  id    String            @id @default(cuid())
  label IncidentTypeLabel @unique

  incidents Incident[]
}

model Incident {
  id              String         @id @default(cuid())
  direction       Direction
  roadStatus      RoadStatus
  photoUrl        String?
  status          IncidentStatus @default(ACTIVE)
  reportedAt      DateTime       @default(now())
  lastConfirmedAt DateTime       @default(now())

  // Geometry column — see note on RoadSegment.geom
  position Unsupported("geometry(Point, 4326)")

  roadSegmentId String
  roadSegment   RoadSegment @relation(fields: [roadSegmentId], references: [id])

  incidentTypeId String
  incidentType   IncidentType @relation(fields: [incidentTypeId], references: [id])

  reportedById String?
  reportedBy   User?   @relation("IncidentReportedBy", fields: [reportedById], references: [id])

  confirmations Confirmation[]

  @@index([roadSegmentId])
  @@index([status])
}

enum ConfirmationType {
  STILL_THERE
  CLEARED
}

model Confirmation {
  id          String           @id @default(cuid())
  type        ConfirmationType
  confirmedAt DateTime         @default(now())

  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  @@index([incidentId])
}

// ---------------------------------------------------------------------------
// Itineraries and tracked trips (cf. cahier des charges §4.1)
// ---------------------------------------------------------------------------

model Itinerary {
  id         String   @id @default(cuid())
  isFavorite Boolean  @default(false)
  createdAt  DateTime @default(now())

  // Start point, end point and computed path (OpenRouteService) — see note on RoadSegment.geom
  startPoint Unsupported("geometry(Point, 4326)")
  endPoint   Unsupported("geometry(Point, 4326)")
  path       Unsupported("geometry(LineString, 4326)")?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  segments ItinerarySegment[]
  trips    Trip[]

  @@index([userId])
}

model ItinerarySegment {
  id String @id @default(cuid())

  itineraryId String
  itinerary   Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)

  roadSegmentId String
  roadSegment   RoadSegment @relation(fields: [roadSegmentId], references: [id])

  @@index([itineraryId])
  @@index([roadSegmentId])
}

enum TripStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

model Trip {
  id        String     @id @default(cuid())
  status    TripStatus @default(IN_PROGRESS)
  startedAt DateTime   @default(now())
  endedAt   DateTime?

  itineraryId String
  itinerary   Itinerary @relation(fields: [itineraryId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
}

// Note: the "1 favorite itinerary max on a free account" rule is enforced at
// the application layer, not as a schema constraint.
