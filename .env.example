# Copier ce fichier en .env et renseigner vos propres valeurs.
# Ne jamais committer le fichier .env (déjà exclu via .gitignore).

NODE_ENV=development
PORT=3000

# --- Base de données (Neon) ---
# DATABASE_URL : chaîne "pooled" — utilisée à l'exécution par l'API (via l'adaptateur Neon).
# MIGRATE_DATABASE_URL : chaîne directe (non poolée) — nécessaire pour `prisma migrate dev`,
# les opérations DDL passant mal par le pooler PgBouncer de Neon.
# Les deux sont visibles dans le dashboard Neon (bouton "Connection string",
# avec/sans l'option "Pooled connection").
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/safewayroad?sslmode=require
MIGRATE_DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/safewayroad?sslmode=require

# --- Stockage photos (Cloudflare R2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_INCIDENTS=safewayroad-incidents
# URL publique servant les objets du bucket (pub-xxxx.r2.dev en dev, domaine personnalisé en prod).
# Distincte de l'endpoint S3 privé (R2_ACCOUNT_ID) utilisé pour signer les requêtes PUT/DELETE.
R2_PUBLIC_URL=

# --- Moteur de routing (OpenRouteService) ---
ORS_API_KEY=
ORS_BASE_URL=https://api.openrouteservice.org

# --- Tuiles de carte (MapTiler) ---
# Utilisée côté frontend, listée ici pour centraliser la config du projet.
MAPTILER_API_KEY=

# --- Authentification ---
# Doit faire au moins 32 caractères, sinon le serveur refuse de démarrer (validation Zod).
JWT_SECRET=change_this_to_a_random_32char_string
JWT_EXPIRES_IN=3600
